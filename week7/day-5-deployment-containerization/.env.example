# =============================================================================
# .env.example — TEMPLATE. Copy thành `.env` rồi điền giá trị local.
#   cp .env.example .env
# `.env` thật KHÔNG được commit Git (đã nằm trong .gitignore / .dockerignore).
# Không đặt password production vào file này.
# =============================================================================

# ---- Image ----
IMAGE_TAG=1.4.0-local

# ---- Runtime config (không nhạy cảm) ----
SPRING_PROFILES_ACTIVE=local
APP_ENV=local
ORDER_SERVICE_PORT=8080
LOG_LEVEL_APP=INFO
JPA_DDL_AUTO=update
FEATURE_STATUS_V2_WRITE=false
FEATURE_STATUS_V2_READ=false

# ---- PostgreSQL ----
POSTGRES_DB=orderdb
POSTGRES_PORT=5432
DB_USERNAME=order_app
# SECRET — điền giá trị local, ví dụ sinh ngẫu nhiên: openssl rand -base64 24
DB_PASSWORD=

# ---- Kafka ----
KAFKA_EXTERNAL_PORT=29092
KAFKA_TOPIC_ORDER_EVENTS=order.events.v1

# ---- Downstream services ----
INVENTORY_SERVICE_URL=http://host.docker.internal:8082
PAYMENT_SERVICE_URL=http://host.docker.internal:8083

